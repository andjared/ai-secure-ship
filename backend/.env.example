# Auth0 settings the backend uses to validate admin access tokens. Copy this
# file to .env and fill in the same values as frontend/.env. Neither is a secret.
# The tenant domain, without https://
AUTH0_DOMAIN=your-tenant.us.auth0.com
# The Auth0 API's identifier (same as VITE_AUTH0_AUDIENCE)
AUTH0_AUDIENCE=https://your-api-identifier
